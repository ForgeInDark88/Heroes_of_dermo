<root>
	<styles>
		<include src="s2r://panorama/styles/dotastyles.vcss_c" />
		<include src="file://{resources}/styles/custom_game/guild_select.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/custom_game/guild_select.js" />
	</scripts>

	<snippets>
		<snippet name="GuildCard">
			<Panel class="GuildCard">
				<Panel id="GuildEmblem">
					<DOTAAbilityImage id="GuildIcon" />
					<Image id="GuildImage" scaling="stretch-to-cover-preserve-aspect" />
				</Panel>
				<Label id="GuildName" text="" />
				<Label id="GuildDescription" html="true" text="" />
				<Panel class="Spacer" />
				<Button id="GuildJoin" class="GuildButton">
					<Label id="GuildJoinLabel" text="ВСТУПИТЬ" />
				</Button>
			</Panel>
		</snippet>
	</snippets>

	<Panel class="GuildSelectRoot" hittest="false">
		<Panel id="GuildSelect">
			<Panel id="GSShade" />
			<Panel id="GSWindow">
				<Label id="GSTitle" text="ВЫБЕРИ ГИЛЬДИЮ" />
				<Label id="GSTimer" text="" />
				<Panel id="GuildCards" />
			</Panel>
		</Panel>
	</Panel>
</root>
